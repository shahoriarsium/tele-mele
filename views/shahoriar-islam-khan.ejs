<%- include('particles/header') %>

<div class="max-w-5xl mx-auto my-10 p-6 bg-white rounded-xl shadow-lg">
    <div class="flex flex-col md:flex-row gap-8">
      
      <!-- বাম পাশে MD Shahoriar Islam Khan স্যারের পরিচিতি -->
      <div class="w-full md:w-1/3 text-center md:text-left border-b md:border-b-0 md:border-r border-gray-200 pb-6 md:pb-0 md:pr-8">
        <img src="/asset/images/shahoriar.jpg" alt="MD Shahoriar Islam Khan" class="w-48 h-48 rounded-full mx-auto md:mx-0 object-cover shadow-md mb-4 border-4 border-teal-600" onerror="this.src='https://via.placeholder.com/150'">
        
        <h2 class="text-2xl font-bold text-gray-800">MD Shahoriar Islam Khan</h2>
        <p class="text-teal-600 font-semibold text-lg">Surgeon</p>
        <p class="text-gray-600 font-medium text-sm mb-3">Professor, Dhaka Medical College</p>
        <span class="inline-block bg-teal-100 text-teal-800 text-xs px-3 py-1 rounded-full font-bold mb-4">Experience: 20 Years</span>
        
        <!-- ডিগ্রী ও কনসালটেশন ফি -->
        <div class="mt-4 text-left space-y-2 bg-gray-50 p-4 rounded-lg">
          <p class="text-sm text-gray-700"><strong class="text-gray-900">FRCS:</strong> London, UK</p>
          <p class="text-sm text-gray-700"><strong class="text-gray-900">FCPS:</strong> Dhaka, Bangladesh</p>
          <p class="text-sm text-gray-700"><strong class="text-gray-900">Consultation Fee:</strong> <span class="text-teal-700 font-bold text-base">৳1000</span></p>
        </div>
      </div>
  
      <!-- ডান পাশে ক্যালেন্ডার ও ৪টি নির্দিষ্ট টাইম স্লট -->
      <div class="w-full md:w-2/3">
        <h3 class="text-xl font-bold text-teal-700 mb-6 border-b pb-2">Select Date & Time Slot</h3>
        
        <form action="/proceed-to-checkout" method="POST" class="space-y-6 max-w-lg mx-auto bg-white p-6 rounded-xl shadow">
  
            <!-- ১. ডক্টরের ফিক্সড ইনফরমেশন (হিডেন ইনপুট হিসেবে ব্যাকএন্ডে যাবে) -->
            <input type="hidden" name="doctorName" value="Dr. Shahoriar Islam Khan">
            <input type="hidden" name="fees" value="1000">
          
            <!-- ২. রোগীর নিজের ডিটেইলস (Patient Details) -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Patient Full Name</label>
              <input type="text" name="patientName" placeholder="Enter patient's name" required 
                     class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none">
            </div>
          
            <!-- ৩. ডেট সিলেক্ট করার অপশন (Date Selection) -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Select Booking Date</label>
              <input type="date" name="bookingDate" required 
                     class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none">
            </div>
          
            <!-- ৪. টাইম স্লট সিলেক্ট করার অপশন (Time Slot) -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Choose Time Slot</label>
              <select name="timeSlot" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none">
                <option value="">-- Select a Slot --</option>
                <option value="06:00 PM - 06:30 PM">06:00 PM - 06:30 PM</option>
                <option value="06:30 PM - 07:00 PM">06:30 PM - 07:00 PM</option>
                <option value="07:00 PM - 07:30 PM">07:00 PM - 07:30 PM</option>
              </select>
            </div>
          
            <!-- ৫. সেই সাবমিট বাটন যা চেকআউটে নিয়ে যাবে -->
            <button type="submit" aria-label="Proceed to checkout and complete payment" 
                    class="w-full bg-teal-700 text-white font-bold py-3 rounded-lg hover:bg-teal-800 transition-colors cursor-pointer shadow-md">
              Proceed to Cart & Payment 💳
            </button>
          </form>
  
    </div>
  </div>
  
  <!-- ক্যালেন্ডারের ৩০ দিন ভ্যালিডেশন স্ক্রিপ্ট -->
  <script>
    const dateInput = document.getElementById('bookingDate');
    const today = new Date();
    
    // আজকের ডেট (সর্বনিম্ন সীমা)
    const yyyy = today.getFullYear();
    let mm = String(today.getMonth() + 1).padStart(2, '0');
    let dd = String(today.getDate()).padStart(2, '0');
    dateInput.min = `${yyyy}-${mm}-${dd}`;
  
    // আজকের থেকে ৩০ দিন পর (সর্বোচ্চ সীমা)
    const maxDate = new Date();
    maxDate.setDate(today.getDate() + 30);
    const maxY = maxDate.getFullYear();
    let maxM = String(maxDate.getMonth() + 1).padStart(2, '0');
    let maxD = String(maxDate.getDate()).padStart(2, '0');
    dateInput.max = `${maxY}-${maxM}-${maxD}`;
  </script>

<%- include('particles/footer') %>
