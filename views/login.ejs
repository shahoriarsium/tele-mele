<%- include('./particles/header') %>
<div class="max-w-sm w-full bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
    <div class="text-center mb-6">
      <h2 class="text-3xl font-black text-teal-700 tracking-tight">Welcome Back 👋</h2>
      <p class="text-gray-500 text-sm mt-1">Log in to proceed with your booking</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-50 text-red-600 border border-red-200 p-3 rounded-xl mb-4 text-xs font-bold flex items-center space-x-2">
        <span>❌</span> <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Username or Email</label>
        <input type="text" name="identity" placeholder="Enter your username or email" required 
               class="w-full p-3 border border-gray-200 bg-gray-50 rounded-xl focus:ring-2 focus:ring-teal-500 focus:bg-white focus:outline-none transition-all">
      </div>
      
      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider">Password</label>
        </div>
        <input type="password" name="password" placeholder="Enter your password" required 
               class="w-full p-3 border border-gray-200 bg-gray-50 rounded-xl focus:ring-2 focus:ring-teal-500 focus:bg-white focus:outline-none transition-all">
      </div>
      
      <button type="submit" class="w-full bg-teal-600 text-white py-3 rounded-xl font-bold hover:bg-teal-700 shadow-md transition-colors cursor-pointer mt-2">
        Log In Securely 🔒
      </button>
    </form>
    
    <div class="text-xs text-center text-gray-500 mt-6 border-t border-gray-100 pt-4">
      Don't have an account yet? <a href="/signup" class="text-teal-600 font-bold hover:underline">Sign up here</a>
    </div>
  </div>
  <%- include('./particles/footer') %>