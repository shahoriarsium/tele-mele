
<%- include('particles/header') %>

  <!-- ইমেজ ব্যানার ব্যবহার করতে চাইলে নিচের কোডটি দিন -->
  <section class="cover-picture max-w-7xl mx-auto w-full px-4 md:px-8 mt-6">
    <div class="w-full rounded-2xl overflow-hidden shadow-md">
        <!-- 'your-banner-image.jpg' এর জায়গায় আপনার ইমেজ ফাইলের নাম দিন -->
        <img src="/asset/telemart_homecover.png" alt="Banner">
    </div>
</section>
   <section class="services py-10 max-w-7xl mx-auto w-full px-4 md:px-8">
    <div class="service-mother-div grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
        
        <div class="service-child-div1 bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition duration-300 text-center border border-emerald-100/50 flex flex-col items-center">
            <div class="w-16 h-16 bg-bg-mint rounded-full flex items-center justify-center mb-4"> <a href="/doctors">
                <img src="asset/search.png" alt="telemart" class="w-8 h-8 object-contain" onerror="this.src='https://img.icons8.com/ios-filled/50/0F766E/search--v1.png'">
            </div>
            <h3 class="text-xl font-bold mb-2 text-primary">Search</h3>
            <p class="text-lg text-gray-600">Search your doctor near you</p>
          </a>
        </div>
        
        <div class="service-child-div2 bg-white p-6 rounded-2xl shadow-md hover:shadow-lg transition duration-300 text-center border-2 border-secondary flex flex-col items-center relative">
            <span class="absolute top-4 right-4 flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-secondary"></span>
            </span>
            <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center mb-4">
                <img src="asset/time.png" alt="calender" class="w-8 h-8 object-contain" onerror="this.src='https://img.icons8.com/ios-filled/50/10B981/appointment-reminders.png'">
            </div>
            <h3 class="text-xl font-bold mb-2 text-primary">Book</h3>
            <p class="text-lg text-gray-600">Book your appointment instantly</p>
        </div>
        
        <div class="service-child-div3 bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition duration-300 text-center border border-emerald-100/50 sm:col-span-2 md:col-span-1 flex flex-col items-center">
            <div class="w-16 h-16 bg-bg-mint rounded-full flex items-center justify-center mb-4">
                <img src="asset/call.png" alt="call" class="w-8 h-8 object-contain" onerror="this.src='https://img.icons8.com/ios-filled/50/0F766E/phone.png'">
            </div>
            <h3 class="text-xl font-bold mb-2 text-primary">Call</h3>
            <p class="text-lg text-gray-600">Call your doctor via video link</p>
        </div>
    </div>
   </section>

   <section class="docs">
       </section>
   
   <section class="promo py-8 max-w-7xl mx-auto w-full px-4 md:px-8">
    <div class="container mx-auto">
      <div class="section-title text-center mb-6">
        <h2 class="text-2xl md:text-3xl font-bold text-primary">Special Offers & Health Packages</h2>
      </div>
  
      <div class="swiper promoSwiper rounded-2xl overflow-hidden shadow-xl">
        <div class="swiper-wrapper">
          
          <div class="swiper-slide p-6 sm:p-10 md:p-12 flex flex-col justify-center min-h-[220px]" style="background: linear-gradient(135deg, #0F766E, #00B4D8);">
            <div class="promo-content max-w-xl">
              <span class="bg-white/20 !text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-3">New User Offer</span>
              <h3 class="text-xl sm:text-2xl md:text-3xl font-bold mb-2 !text-white">Get 50% OFF on Your First Video Consultation!</h3>
              <p class="!text-white/90 text-sm sm:text-base mb-4">Use Promo Code: <strong class="text-yellow-300">HEALTH50</strong></p>
              <button class="bg-white text-primary font-bold px-5 py-2 text-sm rounded-lg hover:bg-opacity-90 transition">Claim Offer</button>
            </div>
          </div>
  
          <div class="swiper-slide p-6 sm:p-10 md:p-12 flex flex-col justify-center min-h-[220px]" style="background: linear-gradient(135deg, #0F766E, #10B981);">
            <div class="promo-content max-w-xl">
              <span class="bg-white/20 !text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-3">Family Package</span>
              <h3 class="text-xl sm:text-2xl md:text-3xl font-bold mb-2 !text-white">Full Body Checkup for the Whole Family</h3>
              <p class="!text-white/90 text-sm sm:text-base mb-4">Complete health screening by expert doctors at just $49.</p>
              <button class="bg-white text-teal-800 font-bold px-5 py-2 text-sm rounded-lg hover:bg-opacity-90 transition">View Details</button>
            </div>
          </div>
  
          <div class="swiper-slide p-6 sm:p-10 md:p-12 flex flex-col justify-center min-h-[220px]" style="background: linear-gradient(135deg, #1E3A8A, #F43F5E);">
            <div class="promo-content max-w-xl">
              <span class="bg-white/20 !text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-3">Friday Special</span>
              <h3 class="text-xl sm:text-2xl md:text-3xl font-bold mb-2 !text-white">Free Consultation for Mother & Child</h3>
              <p class="!text-white/90 text-sm sm:text-base mb-4">Every Friday with our expert Gynecologists and Pediatricians.</p>
              <button class="bg-white text-red-900 font-bold px-5 py-2 text-sm rounded-lg hover:bg-opacity-90 transition">Book Now</button>
            </div>
          </div>
  
        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-next !text-white scale-75 md:scale-100"></div>
        <div class="swiper-button-prev !text-white scale-75 md:scale-100"></div>
      </div>
    </div>
  </section>
   
  <%- include('particles/footer') %>

   <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
   
   <script>
    var swiper = new Swiper(".promoSwiper", {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: true,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
    });
  </script>
</body>
</html>