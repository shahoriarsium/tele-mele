<%- include('particles/header') %>

<div class="max-w-7xl mx-auto bg-white p-6 rounded-lg shadow-md">
  <h2 class="text-2xl font-bold text-teal-700 mb-6 text-center">Available Doctors List</h2>

  <form action="/doctors" method="GET" class="mb-8 bg-gray-50 p-4 rounded-lg border border-gray-200 flex flex-col md:flex-row gap-4 items-end">
  
    <div class="flex-1 w-full">
      <label class="block text-sm font-medium text-gray-700 mb-1">Search by Name</label>
      <input type="text" name="search" value="<%= currentSearch %>" placeholder="e.g. Dr. Asif" 
             class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-500">
    </div>
  
    <div class="flex-1 w-full">
      <label class="block text-sm font-medium text-gray-700 mb-1">Select Department</label>
      <select name="speciality" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-500">
        <option value="">All Departments</option>
        <% departments.forEach(dept => { %>
          <option value="<%= dept %>" <%= currentSpeciality === dept ? 'selected' : '' %>><%= dept %></option>
        <% }) %>
      </select>
    </div>
  
    <div class="w-full md:w-auto">
      <button type="submit" class="w-full md:w-auto bg-teal-700 text-white px-6 py-2 rounded-md hover:bg-teal-800 font-semibold cursor-pointer transition-colors">
        Search
      </button>
    </div>
    
    <% if(currentSearch || currentSpeciality) { %>
      <div class="w-full md:w-auto">
        <a href="/doctors" class="w-full md:w-auto block text-center bg-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-400 font-semibold transition-colors">
          Clear
        </a>
      </div>
    <% } %>
  </form>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
    
    <% if (allDoctors.length === 0) { %>
      <p class="text-gray-500 text-center col-span-full">দুঃখিত, এই মুহূর্তে কোনো ডক্টর উপলব্ধ নেই।</p>
    <% } else { %>
      <% allDoctors.forEach(doctor => { %>
        
        <div class="p-5 border border-gray-200 flex flex-col justify-between bg-gray-50 rounded-lg shadow-sm hover:shadow-md transition-shadow">
          <div>
            <h3 class="text-lg font-bold text-gray-800 mb-1"><%= doctor.name %></h3>
            <p class="text-sm text-teal-600 font-medium mb-3"><%= doctor.speciality %></p>
            
            <hr class="border-gray-200 mb-3">
            
            <p class="text-sm text-gray-600 mb-1">
              <span class="font-semibold">Experience:</span> <%= doctor.experience %>
            </p>
            <p class="text-sm text-gray-600 mb-4">
              <span class="font-semibold">Fees:</span> <span class="text-teal-700 font-bold">৳<%= doctor.fees %></span>
            </p>
          </div>
          
          <button class="w-full bg-teal-600 text-white text-sm py-2 rounded-md hover:bg-teal-700 font-semibold cursor-pointer transition-colors mt-auto">
            <!-- ডক্টর লিস্টের লুপের ভেতর বুকিং বাটনের কোডটি খুঁজে এটি বসিয়ে দিন -->
              <a href="<%= doctor.profileUrl %>" class="inline-block bg-teal-600 hover:bg-teal-700 text-white font-bold py-2 px-4 rounded transition">
                  Book Appointment 📅
              </a>
          </button>
        </div>

      <% }) %>
    <% } %>

  </div>
</div>

<%- include('particles/footer') %>