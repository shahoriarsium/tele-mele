<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TeleMele - Restricted Admin Access</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-950 flex flex-col min-h-screen font-sans antialiased">

  <header class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex justify-between items-center">
    <a href="/doctors" class="text-xl font-black text-teal-400 tracking-tight">TeleMele ⚡ <span class="text-xs text-slate-500 font-normal">Admin Portal</span></a>
    <a href="/doctors" class="text-xs text-slate-400 hover:text-slate-200 underline">Back to Site</a>
  </header>

  <main class="flex-grow flex items-center justify-center p-4">
    <div class="max-w-sm w-full bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-800">
      <div class="text-center mb-6">
        <div class="inline-block p-3 bg-teal-500/10 rounded-2xl mb-3 text-teal-400 text-2xl">
          🔒
        </div>
        <h2 class="text-2xl font-black text-slate-100 tracking-tight">Admin Gatekeeper</h2>
        <p class="text-slate-500 text-xs mt-1 uppercase tracking-widest font-bold">Authorized Personnel Only</p>
      </div>

      <% if (error) { %>
        <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-3 rounded-xl mb-4 text-xs font-semibold text-center">
          <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Secure Username</label>
          <input type="text" name="username" placeholder="Username" required 
                 class="w-full p-3 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-sm focus:ring-2 focus:ring-teal-500 focus:outline-none transition-all">
        </div>
        
        <div>
          <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Security Password</label>
          <input type="password" name="password" placeholder="••••••••" required 
                 class="w-full p-3 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-sm focus:ring-2 focus:ring-teal-500 focus:outline-none transition-all">
        </div>
        
        <button type="submit" class="w-full bg-teal-600 hover:bg-teal-500 text-white py-3 rounded-xl font-bold text-sm shadow-lg shadow-teal-600/10 transition-colors cursor-pointer mt-2">
          Verify Credentials ⚙️
        </button>
      </form>
    </div>
  </main>

  <footer class="bg-slate-900 border-t border-slate-800 py-4 text-center text-xs text-slate-500">
    &copy; 2026 TeleMele Admin Terminal. All Rights Reserved.
  </footer>

</body>
</html>