<%- include('particles/header') %>


<div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
    <div class="text-center mb-6">
      <h2 class="text-3xl font-black text-teal-700 tracking-tight">Join TeleMele ⚡</h2>
      <p class="text-gray-500 text-sm mt-1">Create an account to book your doctor instantly</p>
    </div>
    
    <% if (error) { %>
      <div class="bg-red-50 text-red-600 border border-red-200 p-3 rounded-xl mb-4 text-xs font-bold flex items-center space-x-2">
        <span>⚠️</span> <span><%= error %></span>
      </div>
    <% } %>

    <form action="/signup" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Full Name</label>
        <input type="text" name="name" placeholder="e.g. Rahat Islam" required 
               class="w-full p-3 border border-gray-200 bg-gray-50 rounded-xl focus:ring-2 focus:ring-teal-500 focus:bg-white focus:outline-none transition-all">
      </div>
      
      <div>
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Unique Username</label>
        <input type="text" name="username" placeholder="e.g. rahat99" required 
               class="w-full p-3 border border-gray-200 bg-gray-50 rounded-xl focus:ring-2 focus:ring-teal-500 focus:bg-white focus:outline-none transition-all">
      </div>
      
      <div>
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Email Address</label>
        <input type="email" name="email" placeholder="rahat@example.com" required 
               class="w-full p-3 border border-gray-200 bg-gray-50 rounded-xl focus:ring-2 focus:ring-teal-500 focus:bg-white focus:outline-none transition-all">
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Phone Number</label>
          <input type="text" name="number" placeholder="017XXXXXXXX" required 
                 class="w-full p-3 border border-gray-200 bg-gray-50 rounded-xl focus:ring-2 focus:ring-teal-500 focus:bg-white focus:outline-none transition-all">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Password</label>
          <input type="password" name="password" placeholder="••••••••" required 
                 class="w-full p-3 border border-gray-200 bg-gray-50 rounded-xl focus:ring-2 focus:ring-teal-500 focus:bg-white focus:outline-none transition-all">
        </div>
      </div>
      
      <div>
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Present Address</label>
        <input type="text" name="address" placeholder="e.g. Mirpur, Dhaka" required 
               class="w-full p-3 border border-gray-200 bg-gray-50 rounded-xl focus:ring-2 focus:ring-teal-500 focus:bg-white focus:outline-none transition-all">
      </div>
      
      <button type="submit" class="w-full bg-teal-600 text-white py-3 rounded-xl font-bold hover:bg-teal-700 shadow-md transition-colors cursor-pointer mt-2">
        Create My Account 🚀
      </button>
    </form>
    
    <div class="text-xs text-center text-gray-500 mt-6 border-t border-gray-100 pt-4">
      Already have an account? <a href="/login" class="text-teal-600 font-bold hover:underline">Login here</a>
    </div>
  </div>


  <%- include('particles/footer') %>